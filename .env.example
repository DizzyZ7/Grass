# Use @BotFather to create the bot. Never commit the real token.
BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Your publicly accessible HTTPS domain, no trailing slash.
PUBLIC_BASE_URL=https://grass.example.org
DATABASE_URL=postgresql+psycopg://grass:grass@localhost:5432/grass
PORT=8000
# LOCAL ONLY: allows browser demo without Telegram initData. Keep false on every publicly accessible deployment.
DEV_MODE=false
LOG_LEVEL=INFO
