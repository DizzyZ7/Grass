# Use @BotFather to create the bot. Never commit the real token.
BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Assigned HTTPS domain from Bothost or your reverse proxy, no trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.bothost.ru
DATABASE_URL=postgresql+psycopg://grass:grass@localhost:5432/grass
PORT=8000
# LOCAL ONLY: allows browser demo without Telegram initData. Keep false on Bothost.
DEV_MODE=false
LOG_LEVEL=INFO
